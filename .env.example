# 로컬 개발용 (npm run dev): 메인 서버 포트
MAIN_PORT=3000

# 로컬 개발용 (npm run dev): 관리자 서버 포트
ADMIN_PORT=4000

# 배포용 (npm start / render.yaml): 통합 서버가 사용할 단일 포트
# Render 등 호스팅에서는 보통 자동으로 주입되므로 직접 설정할 필요 없음
PORT=3000

# 관리자 로그인 계정
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# 세션 암호화 키 (임의의 긴 문자열로 변경하세요)
SESSION_SECRET=please-change-this-secret

# Postgres 연결 문자열 (무료: https://neon.tech 가입 후 발급되는 connection string)
# 예: postgresql://user:password@ep-xxxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Cloudinary 연결 문자열 (무료: https://cloudinary.com 가입 후 Dashboard에서 확인)
# 예: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
