# 이 파일을 .env로 복사한 뒤 실제 값으로 채워서 사용하세요.
#   cp .env.example .env

# ---- 필수 ----

# Postgres 연결 문자열(Neon 등 무료 호스팅 사용 가능). 로컬 개발 시에는
# localhost를 가리키면 SSL 없이 접속함(shared/db.js 참고).
DATABASE_URL=postgresql://user:password@localhost:5432/streetmathfighter

# Cloudinary 계정의 연결 문자열(문제 이미지 업로드/삭제에 사용).
# https://cloudinary.com 무료 계정의 Dashboard에서 확인 가능.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# 관리자 로그인 계정. 실제 배포 시 반드시 강한 비밀번호로 바꾸세요.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# express-session 쿠키 서명에 쓰는 비밀 키. 배포 시 무작위 문자열로 바꾸세요
# (예: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
SESSION_SECRET=dev-secret-please-change

# ---- 선택 (기본값 있음) ----

# 통합 서버(server.js, `npm start`)가 사용할 포트.
PORT=3000

# 학생용/관리자용 서버를 각각 따로 띄울 때(`npm run dev`) 쓰는 포트.
MAIN_PORT=3000
ADMIN_PORT=4000

# production으로 설정하면 세션 쿠키에 Secure 플래그가 붙고 요청 로그 형식이
# 배포용(combined)으로 바뀜. render.yaml에는 이미 설정되어 있음.
NODE_ENV=development
