# 로컬 개발용 (npm run dev): 메인 서버 포트
MAIN_PORT=3000

# 로컬 개발용 (npm run dev): 관리자 서버 포트
ADMIN_PORT=4000

# 배포용 (npm start / render.yaml): 통합 서버가 사용할 단일 포트
# Render/Railway 등 호스팅에서는 보통 자동으로 주입되므로 직접 설정할 필요 없음
PORT=3000

# 관리자 로그인 계정
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# 세션 암호화 키 (임의의 긴 문자열로 변경하세요)
SESSION_SECRET=please-change-this-secret

# DB(data.sqlite)와 업로드 이미지(uploads/)를 저장할 디렉터리
# 비워두면 프로젝트 루트를 사용. 영구 디스크를 마운트하는 배포 환경에서는
# 그 디스크 경로로 지정하세요 (예: Render 디스크 마운트 경로 /var/data)
DATA_DIR=
